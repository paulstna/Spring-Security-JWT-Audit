    "/api/v1/auth/refresh" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Exchange the refresh cookie for a new access token",
        "description" : "Rotates the refresh token: the old one is revoked and a new cookie is issued, so a stolen token is usable at most once. The token is bound to the User-Agent that obtained it and is rejected from any other client.",
        "operationId" : "refreshToken",
        "responses" : {
          "200" : {
            "description" : "New access token, refresh token rotated.",
            "headers" : {
              "Set-Cookie" : {
                "description" : "Refresh token, HttpOnly, SameSite=Strict, scoped to /api/v1/auth.",
                "style" : "simple",
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Cookie missing, malformed, expired, already rotated, or presented by a different client. An access token is not accepted here.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429" : {
            "description" : "Rate limit exceeded for this client IP. Wait the number of seconds in the Retry-After header.",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds until the next attempt is allowed.",
                "schema" : { }
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500" : {
            "description" : "Unexpected failure. The body carries a traceId that matches the log entry; no internal detail is exposed.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "refreshCookie" : [ ]
        } ]
      }
    },
