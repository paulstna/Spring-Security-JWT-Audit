  "components" : {
    "schemas" : {
      "UserRequest" : {
        "type" : "object",
        "description" : "Payload for creating or updating a user. The password is required on create and optional on update, where omitting it keeps the current one.",
        "properties" : {
          "username" : {
            "type" : "string",
            "description" : "Username may only contain letters, digits, dots, underscores and hyphens",
            "example" : "ada.lovelace",
            "maxLength" : 50,
            "minLength" : 3,
            "pattern" : "^[a-zA-Z0-9._-]+$"
          },
          "password" : {
            "type" : "string",
            "format" : "password",
            "description" : "Password must contain an uppercase letter, a lowercase letter, a digit and a special character. Omit on update to keep the current one.",
            "example" : "Str0ng!Pass",
            "maxLength" : 72,
            "minLength" : 8,
            "pattern" : "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).+$"
          },
          "roles" : {
            "type" : "array",
            "description" : "Role names, with or without the ROLE_ prefix. Only roles at or below the caller's own level may be granted, so SYSTEM is never assignable. Omit for a plain USER.",
            "example" : [ "MANAGER" ],
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "username" ]
      },
      "ErrorResponse" : {
        "description" : "Every failure in this API has this shape.",
        "properties" : {
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 400
          },
          "message" : {
            "type" : "string",
            "description" : "Safe to show a user. Never carries a stack trace or internal detail.",
            "example" : "Validation failed"
          },
          "path" : {
            "type" : "string",
            "example" : "/api/v1/users"
          },
          "traceId" : {
            "type" : "string",
            "description" : "The id this request was logged under. Quote it and the exact request can be found in the logs.",
            "example" : "b8f1c2d3-4e5a-6b7c-8d9e-0f1a2b3c4d5e"
          },
          "fieldErrors" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string",
              "description" : "Only present on a validation failure.",
              "example" : "{\"password\":\"Password must be between 8 and 72 characters\"}"
            },
            "description" : "Only present on a validation failure.",
            "example" : {
              "password" : "Password must be between 8 and 72 characters"
            }
          }
        }
      },
      "UserResponse" : {
        "type" : "object",
        "description" : "A user as the API exposes it. Deliberately not the entity: the password hash and the session tokens have no field here to leak through.",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "6c2f1b7e-6f1a-4c3e-9f4a-2b8d5c1e7a90"
          },
          "username" : {
            "type" : "string",
            "example" : "ada.lovelace"
          },
          "roles" : {
            "type" : "array",
            "description" : "Granted roles, always prefixed with ROLE_.",
            "example" : [ "ROLE_MANAGER" ],
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          },
          "enabled" : {
            "type" : "boolean",
            "description" : "A disabled account cannot sign in, and its live tokens stop working."
          },
          "accountNonLocked" : {
            "type" : "boolean",
            "description" : "False once the account is locked. Same effect as disabling, different reason in the audit trail."
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "RegisterRequest" : {
        "type" : "object",
        "description" : "A new account. It always gets the USER role; roles cannot be requested here.",
        "properties" : {
          "username" : {
            "type" : "string",
            "description" : "Username may only contain letters, digits, dots, underscores and hyphens",
            "example" : "ada.lovelace",
            "maxLength" : 50,
            "minLength" : 3,
            "pattern" : "^[a-zA-Z0-9._-]+$"
          },
          "password" : {
            "type" : "string",
            "format" : "password",
            "description" : "Password must contain an uppercase letter, a lowercase letter, a digit and a special character. Capped at 72 bytes because BCrypt silently ignores anything past that.",
            "example" : "Str0ng!Pass",
            "maxLength" : 72,
            "minLength" : 8,
            "pattern" : "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).+$"
          }
        },
        "required" : [ "password", "username" ]
      },
