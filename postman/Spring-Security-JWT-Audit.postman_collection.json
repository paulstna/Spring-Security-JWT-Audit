    {
      "name": "Rate limiting",
      "item": [
        {
          "name": "429 — repeat until the login bucket is empty",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"Wrong1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Login allows 5 attempts per minute per client IP, refilling 2 every 60 seconds. Run this in the Collection Runner (or newman): it calls itself until the bucket is empty. Sending it once by hand does not loop."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempt = Number(pm.collectionVariables.get('rateLimitAttempt') || 0) + 1;",
                  "pm.collectionVariables.set('rateLimitAttempt', attempt);",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.test('the bucket runs out and answers 429', () => pm.response.to.have.status(429));",
                  "    pm.test('tells the client how long to wait', () =>",
                  "        pm.expect(pm.response.headers.get('Retry-After')).to.be.a('string'));",
                  "    pm.test('uses the same error shape as everything else', () => {",
                  "        const body = pm.response.json();",
                  "        pm.expect(body.status).to.equal(429);",
                  "        pm.expect(body.message).to.include('Rate limit exceeded');",
                  "        pm.expect(body.traceId).to.be.a('string');",
                  "    });",
                  "    pm.collectionVariables.set('rateLimitAttempt', 0);",
                  "    // No setNextRequest: the run simply carries on.",
                  "} else if (attempt < 12) {",
                  "    postman.setNextRequest('429 — repeat until the login bucket is empty');",
                  "} else {",
                  "    pm.collectionVariables.set('rateLimitAttempt', 0);",
                  "    pm.test('the limiter should have fired by now', () =>",
                  "        pm.expect.fail('12 logins went through without a 429'));",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "description": "Kept last: it deliberately empties the login bucket, so anything after it would be throttled. Wait a minute before signing in again."
    }
