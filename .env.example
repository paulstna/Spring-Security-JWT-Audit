# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# ── Runtime profile ──────────────────────────────────────
# prod -> HTTPS-only refresh cookie, INFO logging
# dev  -> refresh cookie over plain HTTP, DEBUG logging, SQL echoed
# Both profiles run the same migrations and seed the same demo users.
SPRING_PROFILES_ACTIVE=prod

# ── Database ─────────────────────────────────────────────
DB_NAME=spring_security_db
DB_USERNAME=sa
DB_PASSWORD=change_me

# ── JWT Security ─────────────────────────────────────────
# JWT_SECRET_KEY must be a Base64-encoded secret (it is read with Decoders.BASE64).
# Use at least 64 bytes: JJWT picks the strongest algorithm the key supports, so
# a shorter secret silently signs with HS384 or HS256 instead of HS512.
# Generate one with (the tr is not optional: openssl wraps base64 at 64
# characters, and on Git Bash for Windows it ends lines with CRLF, so a value
# left as-is either spans two lines or hides a carriage return, and the
# application refuses to start with "Illegal base64 character"):
#   openssl rand -base64 64 | tr -d '\r\n'
JWT_SECRET_KEY=replace_with_a_base64_encoded_512bit_secret

# Access token lifetime in seconds (default 900 = 15 min)
JWT_AUTH_EXPIRATION=900

# Refresh token lifetime in seconds (default 1296000 = 15 days)
JWT_REFRESH_EXPIRATION=1296000
