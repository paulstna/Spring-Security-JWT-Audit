# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# ── Runtime profile ──────────────────────────────────────
# prod -> HTTPS-only refresh cookie, INFO logging
# dev  -> refresh cookie over plain HTTP, DEBUG logging, SQL echoed
# Both profiles run the same migrations and seed the same demo users.
SPRING_PROFILES_ACTIVE=prod

# ── Database ─────────────────────────────────────────────
DB_NAME=spring_security_db
DB_USERNAME=sa
DB_PASSWORD=change_me

# ── JWT Security ─────────────────────────────────────────
# JWT_SECRET_KEY must be a Base64-encoded secret of at least 256 bits (HS256).
# Generate one with:
#   openssl rand -base64 48
# or in Java:
#   io.jsonwebtoken.security.Keys.secretKeyFor(SignatureAlgorithm.HS256)
JWT_SECRET_KEY=replace_with_a_base64_encoded_256bit_secret

# Access token lifetime in seconds (default 900 = 15 min)
JWT_AUTH_EXPIRATION=900

# Refresh token lifetime in seconds (default 1296000 = 15 days)
JWT_REFRESH_EXPIRATION=1296000
